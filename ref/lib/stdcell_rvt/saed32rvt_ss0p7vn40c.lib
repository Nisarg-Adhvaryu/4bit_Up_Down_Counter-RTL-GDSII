 				direction : "input" ;
 				signal_type : "test_scan_enable";
 			}
 			pin (SI) {
 				direction : "input" ;
 				signal_type : "test_scan_in";
 			}
 			pin (CLK) {
 				direction : "input" ;
 			}
 			pin (RSTB) {
 				direction : "input" ;
 			}
 			pin (SAVE) {
