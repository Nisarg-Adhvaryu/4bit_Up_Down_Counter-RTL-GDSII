 				direction : "input" ;
 				signal_type : "test_scan_in";
 			}
 			pin (CLK) {
 				direction : "input" ;
 			}
 			pin (RSTB) {
 				direction : "input" ;
 			}
 			pin (SAVE) {
 				direction : "input" ;
 			}
 			pin (QN) {
 				direction : "output" ;
 				function : "IQN" ;
 				signal_type : "test_scan_out_inverted";
 			}
 			pin (Q) {
 				direction : "output" ;
 				function : "IQ" ;
 				signal_type : "test_scan_out";
 			}
 			pin (D) {
 				direction : "input" ;
 			}
