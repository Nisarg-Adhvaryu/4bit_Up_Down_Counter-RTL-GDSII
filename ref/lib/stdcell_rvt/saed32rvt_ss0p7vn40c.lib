 				signal_type : "test_scan_out";
 			}
 			pin (D) {
 				direction : "input" ;
 			}
 			pin (NRESTORE) {
 				direction : "input" ;
 			}
 			pin (SETB) {
 				direction : "input" ;
 			}
 		} /* end-of-test-cell */
 	}
