 library ("saed32rvt_tt0p78vn40c") {
 	define(driver_model,library,string);
 	define(def_sim_opt,library,string);
 	define(simulator,library,string);
 	define(always_on,cell,string);
 	define(is_decap_cell,cell,string);
 	define(clk_width,timing,string);
 	technology("cmos");
 	delay_model : "table_lookup";
 	date : "[2010 APRIL 28]";
 	revision : "1.0000000";
 	time_unit : "1ns";
 	leakage_power_unit : "1pW";
 	voltage_unit : "1V";
 	pulling_resistance_unit : "1kohm";
 	current_unit : "1uA";
 	capacitive_load_unit(1.000000, \
 	"ff");
 	default_leakage_power_density : 0.000000;
 	input_threshold_pct_rise : 50.000000;
 	output_threshold_pct_rise : 50.000000;
 	input_threshold_pct_fall : 50.000000;
 	output_threshold_pct_fall : 50.000000;
 	slew_lower_threshold_pct_rise : 20.000000;
 	slew_upper_threshold_pct_rise : 80.000000;
 	slew_lower_threshold_pct_fall : 20.000000;
 	slew_upper_threshold_pct_fall : 80.000000;
 	slew_derate_from_library : 1.000000;
 	default_inout_pin_cap : 0.000000;
 	default_cell_leakage_power : 0.000000;
 	default_input_pin_cap : 0.000000;
 	default_output_pin_cap : 0.000000;
 	default_fanout_load : 1.000000;
 	library_features("report_delay_calculation"); 
 	library_features("report_noise_calculation"); 
 	library_features("report_power_calculation");
 	driver_model : "snps_predriver";
 	nom_voltage : 0.780000;
 	nom_temperature : -40.000000;
 	nom_process : 1.00;
 	default_threshold_voltage_group : "saed32cell_svt";
 	def_sim_opt : "POST=1 PROBE POST_VERSION=2001 INGOLD=2 NOMOD NOPAGE NUMDGT=10 MEASDGT=10 LIMPTS=500000 ICSWEEP=0 AUTOSTOP ALTCC=1 RUNLVL=5 ACCURATE=1 ABSVAR=1.000000e-03 RELVAR=1.000000e-02";
 	simulator : "HSPICE -- C-2009.03-SP1 32-BIT (May 25 2009)";
 	voltage_map(VDD,0.780000);
 	voltage_map(VDDG,0.780000);
 	voltage_map(VSS,0.000000);
 	output_voltage (DC_0) {
 		vol : 0.039;
 		voh : 0.741;
 		vomin : 0;
 		vomax : VDD;
 	}
